{
  "model_name": "S2S",
  "inputs": "rgbt",
  "dataset": "SUS",
  "root": "data/SUS",
  "n_classes": 6,
  "class_names": [
    "unlabeled",
    "road",
    "sidewalk",
    "person",
    "car",
    "bicycle"
  ],
  "exclude_classes_from_mean": [
    0
  ],
  "id_unlabel": 255,
  "dense_text_feature_path": "MyModel/dense/dense_text_features_longclip.pt",
