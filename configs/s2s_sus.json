  "brightness": 0.5,
  "contrast": 0.5,
  "saturation": 0.5,
  "p": 0.5,
  "scales_range": "0.5 2.0",
  "crop_size": "480 640",
  "ims_per_gpu": 4,
  "eval_batch_size": 1,
  "num_workers": 4,
  "lr_start": 0.0005,
  "weight_decay": 0.0005,
  "lr_power": 0.9,
  "epochs": 300,
  "class_weight": "enet",
  "seed": 33,
  "amp": true
}
