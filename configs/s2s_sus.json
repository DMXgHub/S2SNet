  "dinov3_local_path": "dinov3-main",
  "dinov3_weight_path": "",
  "freeze_backbone": true,
  "prompt_balance_weight": 0.01,
  "prompt_confidence_weight": 0.001,
  "prompt_route_history_maxlen": 1,
  "proto_contrast_temperature": 0.05,
